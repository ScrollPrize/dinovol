{
  "output_dir": "${OUTPUT_DIR}",
  "resume": true,
  "auto_resume": true,
  "wandb_project": null,
  "lr": 2.5e-5,
  "min_lr": 1e-6,
  "weight_decay": 0.04,
  "weight_decay_end": 0.2,
  "patch_embed_lr_mult": 0.2,
  "freeze_last_layer_steps": 1250,
  "momentum_teacher": 0.994,
  "final_momentum_teacher": 1.0,
  "warmup_steps": 35000,
  "warmup_teacher_temp": 0.04,
  "teacher_temp": 0.07,
  "warmup_teacher_temp_steps": 25000,
  "clip_grad": 5.0,
  "max_iterations": 1000000,
  "val_every_n": 500,
  "save_every_n": 2500,
  "batch_size": 1,
  "use_amp": true,
  "amp_dtype": "bf16",
  "centering": "sinkhorn_knopp",
  "num_local_crops": 8,
  "prefetch-factor": 6,
  "dataloader-workers": 14,
  "persistent_workers": true,
  "distributed_timeout_seconds": 1800,
  "parallelism": {
    "strategy": "tp_ddp",
    "tensor_parallel_size": 4
  },
  "koleo": {
    "distributed": true
  },
  "ibot": {
    "max_masked_patches_per_rank": 6144,
    "projection_chunk_size": 1024,
    "loss_chunk_size": 1024
  },
  "model": {
    "global_crops_size": [128, 128, 128],
    "local_crops_size": [64, 64, 64],
    "patch_size": [4, 4, 4],
    "model_type": "v2",
    "embedding_type": "default",
    "use_abs_pos_emb": false,
    "use_rot_pos_emb": true,
    "rope_type": "mixed",
    "rope_base": 100.0,
    "rope_normalize_coords": "separate",
    "rope_rescale_coords": 2.0,
    "rope_shift_coords": 0.05,
    "rope_jitter_coords": 1.05,
    "init_values": null,
    "drop_path_rate": 0.2,
    "grad_checkpointing": true
  },
  "dataset": {
    "source_crop_size": [256, 256, 256],
    "local_crop_scale": [0.02, 0.25],
    "global_crop_size": [128, 128, 128],
    "local_crop_size": [64, 64, 64],
    "num_local_crops": 8,
    "datasets_file": "${DATASETS_FILE}"
  },
  "val_dataset": {
    "source_crop_size": [256, 256, 256],
    "local_crop_scale": [0.02, 0.25],
    "global_crop_size": [128, 128, 128],
    "local_crop_size": [64, 64, 64],
    "num_local_crops": 8,
    "datasets_file": "${VAL_DATASETS_FILE}"
  }
}
