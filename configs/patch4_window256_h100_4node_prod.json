{
  "output_dir": "${OUTPUT_DIR}",
  "wandb-entity": "vesuvius-challenge",
  "wandb-project": "dinov2_pretrain",
  "wandb-run-name": "${WANDB_RUN_NAME}",
  "wandb-resume": "allow",
  "resume": true,
  "auto_resume": true,
  "lr": 2.5e-5,
  "min_lr": 1e-6,
  "weight_decay": 0.04,
  "weight_decay_end": 0.2,
  "patch_embed_lr_mult": 0.2,
  "freeze_last_layer_steps": 1250,
  "momentum_teacher": 0.994,
  "final_momentum_teacher": 1.0,
  "warmup_steps": 35000,
  "warmup_teacher_temp": 0.04,
  "teacher_temp": 0.07,
  "warmup_teacher_temp_steps": 25000,
  "clip_grad": 5.0,
  "max_iterations": 1000000,
  "val_every_n": 500,
  "save_every_n": 2500,
  "log_every": 20,
  "cluster_metrics": {
    "enabled": true,
    "every_n": 20,
    "query_nvidia_smi": true,
    "log_per_rank": true
  },
  "batch_size": 1,
  "gradient_accumulation_steps": 1,
  "use_amp": true,
  "amp_dtype": "bf16",
  "centering": "sinkhorn_knopp",
  "num_local_crops": 8,
  "view_chunk_size": 1,
  "discard_local_patch_tokens": true,
  "low_memory_global_crops": true,
  "low_memory_local_crops": true,
  "local_loss_chunk_size": 1,
  "prefetch-factor": 1,
  "dataloader-workers": 4,
  "persistent_workers": true,
  "distributed_timeout_seconds": 1800,
  "parallelism": {
    "strategy": "mesh",
    "tensor_parallel_size": 1,
    "context_parallel_size": 2,
    "sharding": "fsdp2"
  },
  "koleo": {
    "distributed": true
  },
  "ibot": {
    "max_masked_patches_per_rank": 20000,
    "projection_chunk_size": 1024,
    "loss_chunk_size": 1024
  },
  "compile": {
    "enabled": true,
    "scope": "blocks",
    "backend": "inductor",
    "mode": "default",
    "fullgraph": false,
    "dynamic": false
  },
  "model": {
    "global_crops_size": [256, 256, 256],
    "local_crops_size": [128, 128, 128],
    "patch_size": [4, 4, 4],
    "model_type": "v2",
    "embedding_type": "default",
    "use_abs_pos_emb": false,
    "use_rot_pos_emb": true,
    "rope_type": "mixed",
    "rope_base": 100.0,
    "rope_normalize_coords": "separate",
    "rope_rescale_coords": 2.0,
    "rope_shift_coords": 0.05,
    "rope_jitter_coords": 1.05,
    "attention_mode": "window_global_3d",
    "window_size_patches": [8, 8, 8],
    "shift_size_patches": [4, 4, 4],
    "alternate_window_shift": true,
    "mlp_token_chunk_size": 8192,
    "init_values": null,
    "drop_path_rate": 0.2,
    "block_chunks": 1,
    "grad_checkpointing": true
  },
  "dataset": {
    "source_crop_size": [256, 256, 256],
    "local_crop_scale": [0.02, 0.25],
    "global_crop_size": [256, 256, 256],
    "local_crop_size": [128, 128, 128],
    "num_local_crops": 8,
    "datasets_file": "${DATASETS_FILE}"
  },
  "val_dataset": {
    "source_crop_size": [256, 256, 256],
    "local_crop_scale": [0.02, 0.25],
    "global_crop_size": [256, 256, 256],
    "local_crop_size": [128, 128, 128],
    "num_local_crops": 8,
    "datasets_file": "${VAL_DATASETS_FILE}"
  }
}
